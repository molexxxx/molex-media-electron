{
  "prefix": ["-hide_banner", "-nostdin", "-nostats", "-progress", "pipe:1", "-stats_period", "0.5"],
  "runs": [
    { "name": "chain-flac-s16", "args": ["-loglevel", "level+error", "-f", "lavfi", "-i", "sine=frequency=997:sample_rate=44100:duration=1", "-filter_complex", "[0:a]aformat=channel_layouts=stereo,aformat=sample_fmts=dbl,volume=6.00dB:precision=double,aresample=220500,alimiter=limit=-1.50dB:attack=20:release=200:level=disabled:latency=1,aresample=osr=44100:osf=s16:dither_method=triangular,aformat=sample_fmts=s16:sample_rates=44100:channel_layouts=stereo[a]", "-map", "[a]", "-c:a", "flac", "-f", "null", "-"] },
    { "name": "chain-opus-51side", "args": ["-loglevel", "level+error", "-f", "lavfi", "-i", "sine=frequency=997:sample_rate=48000:duration=1", "-filter_complex", "[0:a]aformat=channel_layouts=5.1(side),aformat=sample_fmts=dbl,volume=-3.00dB:precision=double,aresample=192000,alimiter=limit=-3.50dB:attack=20:release=200:level=disabled:latency=1,aformat=sample_rates=48000:channel_layouts=5.1[a]", "-map", "[a]", "-c:a", "libopus", "-b:a", "384k", "-f", "null", "-"] },
    { "name": "chain-aac-mono", "args": ["-loglevel", "level+error", "-f", "lavfi", "-i", "sine=frequency=997:sample_rate=32000:duration=1", "-filter_complex", "[0:a]aformat=sample_fmts=dbl,volume=0.00dB:precision=double,aresample=192000,alimiter=limit=-3.50dB:attack=20:release=200:level=disabled:latency=1,aformat=sample_rates=32000:channel_layouts=mono[a]", "-map", "[a]", "-c:a", "aac", "-b:a", "96k", "-aac_coder", "fast", "-f", "null", "-"] },
    { "name": "meter-dual-mono", "args": ["-loglevel", "level+error", "-nostats", "-loglevel", "level+info", "-f", "lavfi", "-i", "sine=frequency=997:sample_rate=48000:duration=5", "-filter_complex", "[0:a]ebur128@st=peak=true:dualmono=true:framelog=verbose[o]", "-map", "[o]", "-f", "null", "-"] },
    { "name": "soxr", "args": ["-loglevel", "level+error", "-f", "lavfi", "-i", "anullsrc=r=48000:cl=stereo", "-t", "0.1", "-af", "aresample=resampler=soxr:precision=33:osr=384000", "-f", "null", "-"] },
    { "name": "encoders", "args": ["-loglevel", "level+error", "-encoders"] },
    { "name": "soxr-missing-engine", "args": ["-loglevel", "level+error", "-f", "lavfi", "-i", "anullsrc=r=48000:cl=stereo", "-t", "0.1", "-af", "aresample=resampler=nosuchengine", "-f", "null", "-"] }
  ]
}
